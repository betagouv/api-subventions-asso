{
  "name": "api-subventions-asso",
  "version": "0.0.0",
  "description": "Projet monorepo de Data.Subvention",
  "main": "index.js",
  "engines": {
    "npm": "use-pnpm-instead",
    "yarn": "use-pnpm-instead",
    "pnpm": "11.x",
    "node": "22.x"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "build:front": "pnpm --filter front... build",
    "build:api": "pnpm --filter api... build",
    "build:dto": "pnpm --filter dto build ",
    "build:core": "pnpm --filter core build",
    "build": "pnpm -r build",
    "scalingo-postbuild": "bash ./build.bash",
    "postinstall": "bash ./post-install.bash",
    "generate": "pnpm --filter api generate",
    "dev": "pnpm -r --parallel dev",
    "start": "node ./packages/api/build/src/index.js",
    "test": "pnpm --filter api --filter front test",
    "migration:apply": "pnpm --filter api migration:apply",
    "release": "commit-and-tag-version",
    "lint-format": "pnpm -r --workspace-concurrency=1 run lint-format",
    "lint": "pnpm -r lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betagouv/api-subventions-asso.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/betagouv/api-subventions-asso/issues"
  },
  "homepage": "https://github.com/betagouv/api-subventions-asso#readme",
  "devDependencies": {
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^16.2.4",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/parser": "^8.31.0",
    "commit-and-tag-version": "~12.7.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "husky": "^7.0.4",
    "lint-staged": "^13.3.0",
    "prettier": "^3.6",
    "rimraf": "^6.1.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.31.0"
  }
}
