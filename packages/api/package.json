{
    "name": "api",
    "version": "0.85.1",
    "description": "",
    "main": "index.js",
    "engines": {
        "npm": "use-pnpm-instead",
        "yarn": "use-pnpm-instead",
        "pnpm": "11.x",
        "node": "22.x"
    },
    "scripts": {
        "dev": "concurrently \"nodemon\" \"nodemon -x tsoa spec-and-routes\"",
        "start": "node ./build/src/index.js",
        "cli": "ts-node src/cli.ts",
        "generate:docs": "tsoa spec",
        "generate:routes": "tsoa routes",
        "generate": "pnpm run generate:routes && pnpm run generate:docs",
        "prebuild": "pnpm run generate",
        "build": "rimraf build && tsc --project tsconfig.build.json",
        "test": "pnpm run test:unit && pnpm run test:integ",
        "test:unit": "NODE_OPTIONS='--max-old-space-size=8192 --experimental-vm-modules' jest -c jest.config.unit.ts --runInBand",
        "test:integ": "NODE_OPTIONS='--max-old-space-size=8192 --experimental-vm-modules' jest -c jest.config.integ.ts --runInBand",
        "test:cov": "pnpm run test:unit -- --coverage",
        "migration:new": "migrate-mongo create",
        "migration:status": "migrate-mongo status",
        "migration:apply": "migrate-mongo up",
        "lint:all": "eslint --fix",
        "prettier": "prettier . --write",
        "lint-format": "lint-staged"
    },
    "lint-staged": {
        "./{migrations,src,tests,tools}/**/*.{js,ts}": [
            "npx prettier --write --loglevel warn",
            "npx eslint --fix --quiet"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/betagouv/api-subventions-asso.git"
    },
    "author": "",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/betagouv/api-subventions-asso/issues"
    },
    "homepage": "https://github.com/betagouv/api-subventions-asso#readme",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1080.0",
        "@aws-sdk/s3-request-presigner": "^3.1080.0",
        "@getbrevo/brevo": "^2.5.0",
        "@inquirer/prompts": "^7.10.1",
        "@sentry/node": "~8.49.0",
        "@tsoa/runtime": "5.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/cors": "^2.8.19",
        "@types/decompress": "^4.2.7",
        "@types/express": "^4.17.25",
        "@types/lodash": "^4.17.24",
        "@types/multer": "^1.4.13",
        "@types/node": "24.10.1",
