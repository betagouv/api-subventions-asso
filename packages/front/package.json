{
    "name": "front",
    "version": "0.84.5",
    "description": "> TODO: description",
    "author": "Victor Serain <victor.serain@epitech.eu>",
    "homepage": "https://github.com/betagouv/api-subventions-asso/tree/main/packages/front#readme",
    "license": "MIT",
    "private": true,
    "engines": {
        "npm": "use-pnpm-instead",
        "yarn": "use-pnpm-instead",
        "pnpm": "10.x",
        "node": "22.x"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/betagouv/datasubvention.git"
    },
    "scripts": {
        "dev": "vite dev --host localhost",
        "vite:clean": "rm -r node_modules/.vite node_modules/.vitest",
        "start": "node ./build/index.js",
        "build": "vite build -l warn",
        "preview": "vite preview",
        "test": "pnpm run test:unit",
        "prepare": "svelte-kit sync",
        "test:unit": "vitest run",
        "lint": "eslint --fix --ext .js,.ts,.svelte",
        "lint:all": "eslint --fix --ext .js,.ts,.svelte",
        "prettier": "prettier --write",
        "prettier:all": "prettier --plugin-search-dir . --write .",
        "lint-format": "lint-staged"
    },
    "lint-staged": {
        "./{src,svelte,views}/**/*.{js,ts,svelte}": [
            "pnpm prettier --write --loglevel warn",
            "pnpm eslint --fix --quiet"
        ]
    },
    "bugs": {
        "url": "https://github.com/betagouv/datasubvention/issues"
    },
    "dependencies": {
        "@gouvfr/dsfr": "^1",
        "@sentry/sveltekit": "^10",
        "@sveltejs/adapter-auto": "^7",
        "@sveltejs/adapter-node": "^5",
        "@sveltejs/kit": "^2",
        "@sveltejs/vite-plugin-svelte": "^6",
        "axios": "^1",
        "chart.js": "^4",
        "csv-stringify": "^6",
        "d3": "^7",
        "dotenv": "^17",
        "dto": "workspace:0.84.0",
        "jschardet": "^3",
        "jsdom": "^29",
        "lodash-es": "^4",
        "nanoid": "^5",
        "string-similarity": "^4",
        "svelte": "^5",
        "vite": "^7",
        "xlsx": "file:../../vendor/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@vitest/eslint-plugin": "^1",
        "eslint-plugin-svelte": "^3",
        "eslint-plugin-vitest-globals": "^1",
        "prettier-plugin-svelte": "^3.5.2",
        "svelte-eslint-parser": "^1",
        "vitest": "^4"
    },
    "type": "module"
}
