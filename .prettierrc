{
    "arrowParens": "avoid",
    "singleQuote": false,
    "plugins": ["prettier-plugin-svelte"],
    "semi": true,
    "svelteSortOrder": "options-scripts-markup-styles",
    "svelteIndentScriptAndStyle": true,
    "trailingComma": "none",
    "printWidth": 120,
    "bracketSameLine": true,
    "htmlWhitespaceSensitivity": "ignore",
    "tabWidth": 4,
    "overrides": [
        {
            "files": "*.svelte",
            "options": { "parser": "svelte" }
        }
    ]
}